TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CURRENCY=JPY
# DEFAULT target only. Once you save a target in the dashboard, that saved value wins.
# Alert when TARGET_MIN <= e-Rate Jual <= TARGET_MAX.
# TARGET_MIN=0 means no floor: a cheaper rate still alerts.
TARGET_MIN=110
TARGET_MAX=113
POLL_MINUTES=60
# Optional dead-man's-switch (e.g. a Healthchecks.io ping URL)
HEALTHCHECK_URL=
