TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CURRENCY=JPY
# Alert when TARGET_MIN <= e-Rate Jual <= TARGET_MAX.
# TARGET_MIN=0 means no floor: a rate below 110 is even cheaper, so it still alerts.
# Set TARGET_MIN=110 for your literal 110..113 band.
TARGET_MIN=0
TARGET_MAX=113
POLL_MINUTES=60
# Optional dead-man's-switch (e.g. a Healthchecks.io ping URL)
HEALTHCHECK_URL=
