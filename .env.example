TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# One-time seed of the watchlist: CODE:min:max, comma separated (min 0 = no floor).
# Only used the first time the monitor starts on an empty database. After that the dashboard owns the
# list (add, remove, edit bands there), so changing this later has no effect.
WATCHLIST=JPY:110:113,SGD:13720:13900
POLL_MINUTES=60
# Rate rows older than this are deleted by the monitor (the dashboard shows up to 10 days).
RETENTION_DAYS=10
# Optional dead-man's-switch (e.g. a Healthchecks.io ping URL)
HEALTHCHECK_URL=
